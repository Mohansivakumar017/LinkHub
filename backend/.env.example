APP_NAME=LinkHub
ENVIRONMENT=local
DEBUG=true
PUBLIC_BASE_URL=http://localhost:8000
POSTGRES_DSN=postgresql+asyncpg://linkhub:linkhub@db:5432/linkhub
REDIS_DSN=redis://redis:6379/0
REDIS_CACHE_ENABLED=true
REDIS_CACHE_TTL_SECONDS=300
CELERY_ENABLED=false
CELERY_EMAIL_ENABLED=false
CELERY_RESULT_BACKEND_ENABLED=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SECOND=1.0
RATE_LIMIT_PATHS=/api/v1/auth/login,/api/v1/auth/refresh,/api/v1/auth/register,/api/v1/auth/forgot-password,/api/v1/auth/resend-verification,/api/v1/auth/reset-password,/api/v1/auth/verify-email
CLEANUP_CLICK_RETENTION_DAYS=90
CLEANUP_SCHEDULE_CRON=0 2 * * *
EXPIRATION_NOTIFICATION_DAYS=3
WEEKLY_REPORT_SCHEDULE_CRON=0 8 * * 1
PLATFORM_ADMIN_EMAILS=
READINESS_TIMEOUT_SECONDS=2.0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@localhost
SMTP_USE_TLS=true
MEDIA_DIR=/app/media
MEDIA_BASE_URL=/media
JWT_SECRET_KEY=dev-only-change-this-jwt-secret-key-32chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=15
REFRESH_TOKEN_EXP_DAYS=30
VERIFY_EMAIL_TOKEN_EXP_MINUTES=1440
RESET_PASSWORD_TOKEN_EXP_MINUTES=30
CORS_ORIGINS=["http://localhost:8080"]
