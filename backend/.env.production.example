APP_NAME=LinkHub
ENVIRONMENT=production
DEBUG=false
PUBLIC_BASE_URL=https://links.example.com
POSTGRES_DB=linkhub
POSTGRES_USER=linkhub
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_SECRET
POSTGRES_DSN=postgresql+asyncpg://linkhub:REPLACE_WITH_SECRET@db:5432/linkhub
REDIS_PASSWORD=REPLACE_WITH_REDIS_SECRET
REDIS_DSN=rediss://:REPLACE_WITH_SECRET@redis:6379/0
REDIS_CACHE_ENABLED=true
CELERY_ENABLED=true
CELERY_EMAIL_ENABLED=true
CELERY_RESULT_BACKEND_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SECOND=1.0
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true
CORS_ORIGINS=["https://links.example.com"]
PLATFORM_ADMIN_EMAILS=admin@example.com
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_GRAFANA_SECRET
